---
import SectionTitle from "./SectionTitle.astro";

const experienceData = [
  {
    role: "Software Engineer",
    company: "Logarithm Studio",
    period: "Mar 2026 - Present",
    details: [
      "Contribute to backend development for a software product, building and maintaining API endpoints and core application features",
      "Collaborate with the team on debugging, testing, and deployment to ensure reliable, production-ready releases",
    ],
  },
  {
    role: "Data Analyst & Content Contributor",
    company: "Fopol Experts",
    period: "Oct 2022 - Present",
    details: [
      "Produce weekly data-driven analytical reports, translating large statistical datasets into clear, actionable recommendations",
      "Build and maintain performance-tracking spreadsheets and metric models",
    ],
  },
  {
    role: "Content Writer & Editor",
    company: "Goalki",
    period: "Nov 2022 - Present",
    details: [
      "Wrote, edited, and published analytical long-form articles and summaries",
      "Maintained editorial quality and consistency across contributors",
    ],
  },
  {
    role: "Content Writer & Designer",
    company: "ArenaHype",
    period: "May 2021 - Nov 2022",
    details: [
      "Created written and visual content for digital platforms",
      "Combined copywriting with graphic design to increase audience engagement",
    ],
  },
];
---

<section
  id="experience"
  class="w-full min-h-screen px-6 py-4 pt-14 bg-background"
>
  <SectionTitle title="Experience" />

  <div class="flex_center w-full py-19">
    <div class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        experienceData.map((exp) => (
          <div class="Fade_Up group relative h-full">
            <div class="relative bg-card/30 hover:bg-card/50 border border-border/50 hover:border-transparent rounded-xl p-6 transition-all duration-300 hover:shadow-[0_0_20px_rgba(123,97,255,0.3)] font-mono backdrop-blur-sm h-full flex flex-col before:absolute before:inset-0 before:rounded-xl before:p-0.5 before:bg-gradient-vibrant before:opacity-0 hover:before:opacity-100 before:transition-opacity before:-z-10">
              <div class="space-y-2 mb-4">
                <p class="text-base sm:text-lg font-bold text-gradient-full">
                  {exp.role}
                </p>
                <p class="text-sm sm:text-base font-semibold text-foreground/90">
                  {exp.company}
                </p>
                <div class="flex items-center gap-2 text-xs sm:text-sm text-foreground/60">
                  <span class="font-medium">{exp.period}</span>
                </div>
              </div>

              <div class="h-px bg-linear-to-r from-transparent via-primary/20 to-transparent mb-4" />

              <ul class="space-y-2 grow">
                {exp.details.map((detail) => (
                  <li class="text-xs sm:text-sm text-foreground/75 flex items-start gap-2 leading-relaxed">
                    <span class="text-gradient-full mt-1 shrink-0 font-bold">
                      ›
                    </span>
                    <span class="flex-1">{detail}</span>
                  </li>
                ))}
              </ul>

              <div class="absolute top-0 right-0 w-16 h-16 bg-linear-to-br from-primary/5 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
